\documentclass[\VAR{settings.font_size | default('9pt')}, a4paper]{extarticle}

% --- Package Imports ---
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}

\BLOCK{ if settings and settings.font_family == 'helvetica' }
\usepackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\BLOCK{ elif settings and settings.font_family == 'palatino' }
\usepackage{mathpazo}
\BLOCK{ elif settings and settings.font_family == 'times' }
\usepackage{mathptmx}
\BLOCK{ elif settings and settings.font_family == 'garamond' }
\usepackage{ebgaramond}
\BLOCK{ elif settings and settings.font_family == 'charter' }
\usepackage{charter}
\BLOCK{ elif settings and settings.font_family == 'palatino' }
\usepackage{mathpazo}
\BLOCK{ elif settings and settings.font_family == 'bookman' }
\usepackage{bookman}
\BLOCK{ elif settings and settings.font_family == 'newcent' }
\usepackage{newcent}
\BLOCK{ elif settings and settings.font_family == 'sans' }
\usepackage{lmodern}
\renewcommand{\familydefault}{\sfdefault}
\BLOCK{ else }
\usepackage{lmodern}
\BLOCK{ endif }

\BLOCK{ if settings and settings.margin }
\usepackage[margin=\VAR{settings.margin}]{geometry}
\BLOCK{ else }
\usepackage[margin=1.2cm]{geometry}
\BLOCK{ endif }

\usepackage{enumitem}
\setlist[itemize]{leftmargin=*, topsep=2pt, partopsep=0pt, parsep=0pt, itemsep=1pt}
\usepackage{titlesec}
\usepackage{hyperref}
\usepackage{parskip}
\setlength{\parskip}{5pt} % airy classic spacing
\linespread{\VAR{settings.line_spacing | default('0.93')}}

% --- Hyperref Config ---
\hypersetup{
    colorlinks=true,
    urlcolor=black,
    linkcolor=black
}

% --- Section Heading Config ---
\titleformat{\section}
  {\bfseries}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{6pt}{4pt}

% --- Disable Page Numbering ---
\pagestyle{empty}

\begin{document}

% --- HEADER ---
\begin{center}
    {\LARGE\bfseries \VAR{personal.name}}\\[4pt]
    \BLOCK{set sep1 = joiner(" \\textbar{} ") }\BLOCK{if personal.phone}\VAR{sep1()}\VAR{personal.phone}\BLOCK{endif}\BLOCK{if personal.email}\VAR{sep1()}\href{mailto:\VAR{personal.email}}{\VAR{personal.email}}\BLOCK{endif}\BLOCK{if personal.location}\VAR{sep1()}\VAR{personal.location}\BLOCK{endif}\\%
    \BLOCK{set sep2 = joiner(" \\textbar{} ") }\BLOCK{if personal.linkedin}\VAR{sep2()}\href{\VAR{personal.linkedin}}{\VAR{personal.linkedin | clean_url}}\BLOCK{endif}\BLOCK{if personal.github}\VAR{sep2()}\href{\VAR{personal.github}}{\VAR{personal.github | clean_url}}\BLOCK{endif}\BLOCK{if personal.portfolio}\VAR{sep2()}\href{\VAR{personal.portfolio}}{\VAR{personal.portfolio | clean_url}}\BLOCK{endif}
\end{center}

% --- Language: settings.language 'en' (default) atau 'id' (Bahasa Indonesia) ---
\BLOCK{ if settings and settings.language }
\BLOCK{ set lang = settings.language }
\BLOCK{ else }
\BLOCK{ set lang = 'en' }
\BLOCK{ endif }
\BLOCK{ set T = {'summary': {'en': 'Professional Summary', 'id': 'Ringkasan Profesional'}, 'experience': {'en': 'Work Experience', 'id': 'Pengalaman Kerja'}, 'projects': {'en': 'Projects', 'id': 'Proyek'}, 'achievements': {'en': 'Achievements', 'id': 'Pencapaian'}, 'skills': {'en': 'Skills', 'id': 'Keahlian'}, 'certifications': {'en': 'Certifications', 'id': 'Sertifikasi'}, 'education': {'en': 'Education', 'id': 'Pendidikan'}, 'technologies': {'en': 'Technologies', 'id': 'Teknologi'}, 'gpa': {'en': 'GPA', 'id': 'IPK'}} }

% --- SUMMARY ---
\BLOCK{if summary}
\section{\VAR{T['summary'][lang]}}
\VAR{summary}
\BLOCK{endif}

% --- EXPERIENCE ---
\section{\VAR{T['experience'][lang]}}
\BLOCK{for job in experience}
\textbf{\VAR{job.title}} \hfill \VAR{job.start_date} -- \VAR{job.end_date}\\
\textit{\VAR{job.company}}, \VAR{job.location}
\BLOCK{if job['bullets']}
\begin{itemize}
\BLOCK{for bullet in job['bullets']}
    \BLOCK{if bullet is mapping}
    \item \textbf{\VAR{bullet.header}}
    \begin{itemize}[leftmargin=1.5em]
        \BLOCK{for item in bullet['items']}
        \item \VAR{item}
        \BLOCK{endfor}
    \end{itemize}
    \BLOCK{else}
    \item \VAR{bullet}
    \BLOCK{endif}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\vspace{1pt}
\BLOCK{endfor}

% --- PROJECTS ---
\BLOCK{if projects}
\section{\VAR{T['projects'][lang]}}
\BLOCK{for project in projects}
\textbf{\VAR{project.name}} \BLOCK{if project.link}\textbar{} \href{\VAR{project.link}}{Link}\BLOCK{endif} \hfill \BLOCK{if project.start_date}\VAR{project.start_date} -- \VAR{project.end_date}\BLOCK{endif}\\
\textit{\VAR{T['technologies'][lang]}: \VAR{project.technologies | join(', ')}}
\BLOCK{if project.description or project['bullets']}
\begin{itemize}
\BLOCK{if project.description}
    \item \VAR{project.description}
\BLOCK{endif}
\BLOCK{for bullet in project['bullets']}
    \BLOCK{if bullet is mapping}
    \item \textbf{\VAR{bullet.header}}
    \begin{itemize}[leftmargin=1.5em]
        \BLOCK{for item in bullet['items']}
        \item \VAR{item}
        \BLOCK{endfor}
    \end{itemize}
    \BLOCK{else}
    \item \VAR{bullet}
    \BLOCK{endif}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\vspace{1pt}
\BLOCK{endfor}
\BLOCK{endif}

% --- ACHIEVEMENTS ---
\BLOCK{if achievements}
\section{\VAR{T['achievements'][lang]}}
\BLOCK{for ach in achievements}
\textbf{\VAR{ach.title}} \hfill \VAR{ach.date}\\
\textit{\VAR{ach.organizer}}
\BLOCK{if ach['bullets']}
\begin{itemize}
\BLOCK{for bullet in ach['bullets']}
    \item \VAR{bullet}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\vspace{1pt}
\BLOCK{endfor}
\BLOCK{endif}

% --- SKILLS ---
\section{\VAR{T['skills'][lang]}}
\BLOCK{for category in skills}
\textbf{\VAR{category.name}}: \VAR{category['items'] | join(', ')}\\
\BLOCK{endfor}

% --- CERTIFICATIONS ---
\BLOCK{if certifications}
\section{\VAR{T['certifications'][lang]}}
\begin{itemize}
\BLOCK{for cert in certifications}
    \item \textbf{\VAR{cert.name}} - \VAR{cert.issuer}\BLOCK{if cert.year}, \VAR{cert.year}\BLOCK{endif}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}

% --- EDUCATION ---
\section{\VAR{T['education'][lang]}}
\BLOCK{for edu in education}
\textbf{\VAR{edu.degree}} \hfill \VAR{edu.graduation_year}\\
\textit{\VAR{edu.institution}}\BLOCK{if edu.location}, \VAR{edu.location}\BLOCK{endif}\BLOCK{if edu.gpa} (\VAR{T['gpa'][lang]}: \VAR{edu.gpa})\BLOCK{endif}
\BLOCK{if edu.thesis}\\
\textit{Thesis: ``\VAR{edu.thesis}''}
\BLOCK{endif}
\BLOCK{endfor}
\end{document}
